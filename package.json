{
	"name": "monorepo",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"setup": "npm install",
		"dev": "concurrently --kill-others --raw \"npm run dev --prefix apps/web\"",
		"build": "npm run sitemap && concurrently --raw \"npm run build --prefix apps/web\" && node scripts/prerender-routes.mjs",
		"sitemap": "node scripts/generate-sitemap.mjs",
		"prerender": "node scripts/prerender-routes.mjs",
		"start": "concurrently --kill-others --raw",
		"lint": "concurrently --raw \"npm run lint --prefix apps/web\""
	},
	"devDependencies": {
		"concurrently": "^10.0.4",
		"knip": "^6.32.1"
	},
	"workspaces": [
		"apps/*"
	],
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
